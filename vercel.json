{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/yokai-musubi run build && pnpm --filter @workspace/api-server run build",
  "outputDirectory": "artifacts/yokai-musubi/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/[...path]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].mjs": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  }
}